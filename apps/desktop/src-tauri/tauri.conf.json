{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GQ-GEO",
  "version": "0.2.0",
  "identifier": "com.gaodekuai.geo",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "搞钱GEO",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$TEMP/gq-geo/**",
          "$APPDATA/**",
          "$APPLOCALDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "面向国内中小企业的生成式引擎优化（GEO）桌面工具",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "RWR2aUNe55NbjNL118psdfS+tfP7/4K0zI+4BqZIoEkRt+Fquyxgd71u",
      "endpoints": [
        "https://geo_api.gaodekuai.com/client/v1/releases/latest.json"
      ]
    }
  }
}
