{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gdk-geo",
  "version": "0.1.0",
  "identifier": "com.gaodekuai.geo",
  "build": {
    "beforeDevCommand": "pnpm --dir ui run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --dir ui run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "稿得快 GEO",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "面向国内中小企业的生成式引擎优化（GEO）桌面工具",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
