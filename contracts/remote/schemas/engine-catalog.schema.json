{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geo_api.gaodekuai.com/schemas/engine-catalog.schema.json",
  "title": "EngineCatalogV1",
  "description": "引擎目录（产品定义 §3.5 的引擎矩阵）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "version",
    "engines"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "description": "🔴 schema_version 只增不改语义；破坏性变更 = 新版本号 + 双跑期"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "engines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "display_name_zh",
          "channel_type",
          "priority",
          "enabled",
          "default_off",
          "sort"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,63}$",
            "description": "小写下划线蛇形，全局唯一且稳定"
          },
          "display_name_zh": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "display_name_en": {
            "type": "string",
            "maxLength": 64
          },
          "channel_type": {
            "enum": [
              "official_api",
              "browser_automation",
              "gateway"
            ],
            "description": "🔴 browser_automation 通道**仅**官网直下载版可用，MSIX 版不含"
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "free_quota_hint_zh": {
            "type": "string",
            "maxLength": 300,
            "description": "如「火山每日 200 万 tokens」"
          },
          "known_limits_zh": {
            "type": "string",
            "maxLength": 500
          },
          "data_export_region": {
            "type": "boolean",
            "default": false,
            "description": "true = 涉及数据出境（ChatGPT/Perplexity/Gemini 等），客户端必须明示"
          },
          "default_off": {
            "type": "boolean",
            "description": "🔴 出境引擎必须 default_off=true"
          },
          "sort": {
            "type": "integer"
          }
        }
      }
    }
  }
}
