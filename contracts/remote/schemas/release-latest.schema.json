{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geo_api.gaodekuai.com/schemas/release-latest.schema.json",
  "title": "ReleaseLatestV1",
  "description": "Tauri v2 updater 契约（plugins.updater.endpoints 指向本文件）。🔴 结构必须严格照 Tauri 官方格式，多一个字段它不认、少一个字段更新失败。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "notes",
    "pub_date",
    "platforms"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "notes": {
      "type": "string",
      "maxLength": 20000,
      "description": "更新日志；🔴 禁用绝对化用语（AGENTS 规则 6）"
    },
    "pub_date": {
      "type": "string",
      "format": "date-time"
    },
    "platforms": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "darwin-aarch64": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "signature",
            "url"
          ],
          "properties": {
            "signature": {
              "type": "string",
              "minLength": 10,
              "description": "minisign 签名（Tauri updater 自验）"
            },
            "url": {
              "type": "string",
              "pattern": "^https://",
              "description": "🔴 Windows 侧必须是 -setup.exe（NSIS），不是 .msi —— 见发布规格 DR-R8 的 updaterJsonPreferNsis"
            }
          }
        },
        "darwin-x86_64": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "signature",
            "url"
          ],
          "properties": {
            "signature": {
              "type": "string",
              "minLength": 10,
